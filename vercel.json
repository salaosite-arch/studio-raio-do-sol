{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(sw\\.js|index\\.html|dashboard\\.html|dashboard\\.js|dashboard\\.css|app\\.js|styles\\.css|api-config\\.js|manifest\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
